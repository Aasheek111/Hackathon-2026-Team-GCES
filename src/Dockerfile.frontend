# BrightMind Frontend — Nginx Dockerfile
FROM nginx:1.27-alpine

LABEL maintainer="BrightMind Team"
LABEL description="BrightMind Accessible Learning Platform Frontend"

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY src/nginx.conf /etc/nginx/conf.d/default.conf

# Copy frontend static files
COPY index.html  /usr/share/nginx/html/
COPY app.css     /usr/share/nginx/html/
COPY app.js      /usr/share/nginx/html/

# Copy EyeTracker components (served as static assets)
COPY src/components/ /usr/share/nginx/html/components/

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
